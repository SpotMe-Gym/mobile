# Copy to .env.local (git-ignored). Without the Supabase values the app works exactly as before
# and the account screens say sign-in isn't available in this build.

# Same Supabase project as the website: Project Settings → API Keys
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Free Apple "Personal Team"? It can't have the Sign In with Apple capability: set this to false,
# then `bun run prebuild:clean`. "Continue with Apple" then opens the browser instead of the native sheet.
# EXPO_PUBLIC_NATIVE_APPLE_SIGN_IN=false

# The website (no trailing slash): email links, password reset, account deletion
EXPO_PUBLIC_SITE_URL=
