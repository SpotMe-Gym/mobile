{
  "expo": {
    "name": "SpotMe",
    "slug": "spotme",
    "scheme": "spotme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/SpotMeIcon/appstore.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.damianoshushku.spotme",
      "appleTeamId": "VEK66395CZ",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow SpotMe to scan food barcodes and to film your exercises.",
        "NSAppleMusicUsageDescription": "SpotMe shows the song playing in Apple Music during your workout and lets you skip it.",
        "NSHealthShareUsageDescription": "SpotMe reads your heart rate from Apple Watch during workouts and saves it with each session.",
        "NSHealthUpdateUsageDescription": "SpotMe saves your strength workouts to Apple Health.",
        "UIBackgroundModes": [
          "workout-processing"
        ],
        "NSPhotoLibraryUsageDescription": "Allow SpotMe to open a video of your exercise that you choose."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/SpotMeIcon/playstore.png",
        "backgroundColor": "#0A0A0A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spotme.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/SpotMeIcon/appstore.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SpotMe to scan food barcodes and to film your exercises.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SpotMe to open a video of your exercise that you choose.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B82F6",
          "enableRemoteNotifications": false
        }
      ],
      [
        "react-native-ble-manager",
        {
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Allow SpotMe to connect to your heart rate monitor."
        }
      ],
      "@bacons/apple-targets"
    ]
  }
}
