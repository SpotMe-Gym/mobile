{
  "name": "spotme",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "i18n:check": "node scripts/check-i18n.js",
    "doctor": "npx expo-doctor",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run i18n:check"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "expo": "^58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "i18next": "^25.10.10",
    "intl-pluralrules": "^2.0.1",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "3.4.17",
    "uuid": "^13.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lucide-react-native|nativewind|react-native-css-interop|@shopify/flash-list|uuid|standard-navigation)"
    ],
    "globalSetup": "./jest.global-setup.js",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/styleMock.js"
    }
  }
}
